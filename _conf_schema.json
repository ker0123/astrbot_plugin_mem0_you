{
  "mem0_api_url_base": {
    "description": "mem0 API url base",
    "hint": "mem0 服务的地址",
    "type": "string",
    "default": "https://api.mem0.ai"
  },
  "mem0_api_key": {
    "description": "mem0 API key",
    "hint": "请求 mem0 服务时的 API Key.",
    "type": "string",
    "default": ""
  },
  "agent_id_prefix": {
    "description": "agent id prefix",
    "hint": "agent_id 前缀，例如 astrbot:<persona_id>。",
    "type": "string",
    "default": "astrbot"
  },
  "search_threshold": {
    "description": "search threshold",
    "hint": "检索相关性阈值。",
    "type": "float",
    "default": 0.1
  },
  "search_timeout": {
    "description": "search timeout",
    "hint": "查询 mem0 的超时时间（秒）；写入超时固定为 300 秒。",
    "type": "float",
    "default": 12
  },
  "inject_p_in_p_chat": {
    "description": "personal memories in private chat",
    "hint": "私聊时注入的个人记忆上限。",
    "type": "int",
    "default": 5
  },
  "inject_p_in_g_chat": {
    "description": "personal memories in group chat",
    "hint": "群聊时注入的发言人个人记忆上限。",
    "type": "int",
    "default": 2
  },
  "inject_g_in_p_chat": {
    "description": "group memories in private chat",
    "hint": "私聊时注入的群记忆上限，所有可见群共享该额度。",
    "type": "int",
    "default": 2
  },
  "inject_g_in_g_chat": {
    "description": "group memories in group chat",
    "hint": "群聊时注入的当前群记忆上限。",
    "type": "int",
    "default": 4
  }
}
